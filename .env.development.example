# Development settings. Copy to .env.development (git ignores it): cp .env.development.example .env.development
DATABASE_URL="postgresql://app:app@localhost:5432/digimarket"
# Encrypts session cookies; at least 32 characters. This one is for development only.
NUXT_SESSION_PASSWORD="dev-only-aB9ChzSTfKPDa3QhpYvUBdt5Lij9e1zD"
STORAGE_DIR="./storage"
SITE_URL="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234"

# Login codes are printed in the server log, so you can log in without SMS or email
LOG_OTP_CODES="true"
# Leave empty to print SMS and emails to the log instead of sending them
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER=""
SMS_OTP_TEMPLATE=""
SMTP_URL=""
MAIL_FROM=""

# Development always uses the ZarinPal sandbox. To use the local mock instead: node tests/payment-mock.mjs
ZARINPAL_BASE_URL=""

# Torob Pay installments (Admin → Settings switches it on). Ask Torob for a test account,
# or point TOROBPAY_BASE_URL at tests/payment-mock.mjs (http://localhost:4010) with any values below
TOROBPAY_BASE_URL=""
TOROBPAY_CLIENT_ID=""
TOROBPAY_CLIENT_SECRET=""
TOROBPAY_USERNAME=""
TOROBPAY_PASSWORD=""
