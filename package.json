{
  "name": "digimarket",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/with-env.mjs production nuxt build",
    "dev": "node scripts/with-env.mjs development nuxt dev",
    "generate": "nuxt generate",
    "preview": "node scripts/with-env.mjs production nuxt preview",
    "postinstall": "nuxt prepare",
    "db:migrate": "node scripts/with-env.mjs development prisma migrate dev",
    "db:deploy": "node scripts/with-env.mjs production prisma migrate deploy",
    "db:seed": "node scripts/with-env.mjs development tsx prisma/seed.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/with-env.mjs test vitest run --config vitest.e2e.config.ts",
    "start": "node scripts/with-env.mjs production node .output/server/index.mjs",
    "db:seed:prod": "node scripts/with-env.mjs production tsx prisma/seed.ts"
  },
  "dependencies": {
    "@adonisjs/hash": "9.1.1",
    "@iconify-json/circle-flags": "^1.2.12",
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/ui": "^4.0.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@prisma/client": "^6.19.3",
    "fzstd": "^0.1.1",
    "h3": "1.15.11",
    "jszip": "^3.10.2",
    "nodemailer": "^7.0.13",
    "nuxt": "^4.6.1",
    "nuxt-auth-utils": "^0.5.31",
    "sanitize-html": "^2.18.1",
    "sql.js": "^1.15.0",
    "tailwindcss": "^4.3.3",
    "vazirmatn": "^33.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/nodemailer": "^7.0.12",
    "@types/sanitize-html": "^2.16.2",
    "@types/sql.js": "^1.4.11",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.13"
  }
}
