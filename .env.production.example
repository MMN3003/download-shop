# Production settings. Copy to .env.production on the server (git ignores it) and fill every value.
# Variables set by the host (Docker, systemd, a panel) take priority over this file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/digimarket"
# Encrypts session cookies; at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=""
STORAGE_DIR="/var/lib/digimarket/storage"
# Public address, used for payment return links
SITE_URL="https://example.com"
# Only used by `pnpm db:seed:prod` to create the first owner
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Login codes are never written to the log in production, whatever this says
LOG_OTP_CODES="false"
# SMS for phone login codes (required for phone login)
SMS_PROVIDER="kavenegar"
SMS_API_KEY=""
SMS_SENDER=""
SMS_OTP_TEMPLATE=""
# Email for email login codes and order notices (required for email login)
SMTP_URL=""
MAIL_FROM="Store <no-reply@example.com>"

# Leave empty to use the real ZarinPal gateway
ZARINPAL_BASE_URL=""
