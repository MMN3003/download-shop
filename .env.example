DATABASE_URL="postgresql://app:app@localhost:5432/digimarket"
# At least 32 characters; used to encrypt session cookies
NUXT_SESSION_PASSWORD=""
# Where uploaded files are stored (public/ and private/ subfolders)
STORAGE_DIR="./storage"
# First admin account created by `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
# Public site address, used for payment gateway return links (defaults to the request's host)
SITE_URL=""
# SMS for login codes. Leave empty to print codes in the server log (development).
SMS_PROVIDER=""          # kavenegar
SMS_API_KEY=""
SMS_SENDER=""
SMS_OTP_TEMPLATE=""      # optional Kavenegar "verify" template name
# Email for login codes and order notices (leave empty to print to the log)
SMTP_URL=""              # e.g. smtps://user:pass@smtp.example.com:465
MAIL_FROM=""
