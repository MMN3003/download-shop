// Generic digital-downloads marketplace.
// The core only knows products, sections, product types and their custom
// attributes. Anything specific to one kind of product (e.g. Anki decks)
// lives in a product type plus an optional server-side plugin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Text in several languages, stored as { "fa": "...", "en": "..." }.
/// Used for every user-facing string so the store can run in any language.

enum Role {
  CUSTOMER
  SELLER
  SUPPORT
  EDITOR
  OWNER
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String?
  name         String?
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  seller       Seller?
  adminLogs    AdminLog[]
  orders       Order[]
  library      LibraryItem[]
  downloads    Download[]
  requests     ProductRequest[]
  requestMsgs  RequestMessage[]
  reports      ContentReport[]
}

/// A seller in the marketplace. The store owner is also a seller.
model Seller {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String    @unique
  displayName   String
  bio           String?
  avatar        String?
  status        String    @default("approved") // pending | approved | rejected | suspended
  /// Payout account
  sheba         String?
  accountHolder String?
  termsAt       DateTime?
  /// Trusted sellers publish without the review queue
  trusted       Boolean   @default(false)
  reviewNote    String?
  createdAt     DateTime  @default(now())
  products      Product[]
  agreements    CommissionAgreement[]
  payouts       Payout[]
}

model Section {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        Json
  description Json?
  icon        String?
  banner      String?
  seoTitle    Json?
  seoDesc     Json?
  showOnHome  Boolean   @default(false)
  sortOrder   Int       @default(0)
  parentId    String?
  parent      Section?  @relation("SectionTree", fields: [parentId], references: [id], onDelete: SetNull)
  /// Set on a parent section whose children are generated from a shared list
  /// (e.g. "Languages" gets one child per language, kept in sync).
  childrenListId String?
  childrenList   OptionList? @relation("SectionChildrenList", fields: [childrenListId], references: [id], onDelete: SetNull)
  /// Set on a generated child: the list item it stands for. Products whose
  /// section-linked field has this value appear here automatically.
  optionItemId   String?     @unique
  optionItem     OptionItem? @relation(fields: [optionItemId], references: [id], onDelete: Cascade)
  children    Section[] @relation("SectionTree")
  products    ProductSection[]
  agreements  CommissionAgreement[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// A kind of product (Anki deck, e-book, audio course...). Defines its own
/// custom fields and, optionally, which plugin analyses its uploaded files.
model ProductType {
  id          String                @id @default(cuid())
  key         String                @unique
  name        Json
  description Json?
  plugin      String?               // e.g. "anki"; null = plain files
  icon        String?
  enabled     Boolean               @default(true)
  attributes  AttributeDefinition[]
  products    Product[]
  createdAt   DateTime              @default(now())
}

enum AttributeKind {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
}

model AttributeDefinition {
  id            String        @id @default(cuid())
  productTypeId String
  productType   ProductType   @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  key           String
  name          Json
  kind          AttributeKind
  /// For SELECT/MULTISELECT: [{ "value": "ar-iq", "label": { "fa": "...", "en": "..." }, "icon"?: "i-circle-flags-iq" }]
  /// When optionListId is set this is a copy of the list, refreshed on every list change.
  options       Json?
  optionListId  String?
  optionList    OptionList?   @relation(fields: [optionListId], references: [id], onDelete: SetNull)
  /// Products appear in the sections generated for the chosen value(s).
  linksSections Boolean       @default(false)
  unit          Json?
  required      Boolean       @default(false)
  filterable    Boolean       @default(false)
  showAsBadge   Boolean       @default(false)
  /// Filled automatically by the type's plugin (still editable by admins).
  autoFilled    Boolean       @default(false)
  sortOrder     Int           @default(0)
  values        ProductAttributeValue[]

  @@unique([productTypeId, key])
}

enum ProductStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  HIDDEN
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique
  productTypeId String
  productType   ProductType   @relation(fields: [productTypeId], references: [id])
  sellerId      String?
  seller        Seller?       @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  status        ProductStatus @default(DRAFT)
  featured      Boolean       @default(false)
  title         Json
  shortDesc     Json?
  description   Json?
  learnPoints   Json?         // { fa: string[], en: string[] }
  cover         String?
  screenshots   String[]
  /// Prices in the store's smallest currency unit (Toman by default).
  price         Int           @default(0)
  salePrice     Int?
  saleStartsAt  DateTime?
  saleEndsAt    DateTime?
  isFree        Boolean       @default(false)
  seoTitle      Json?
  seoDesc       Json?
  /// Normalised text used by search (titles, descriptions, tags).
  searchText    String        @default("")
  tags          String[]
  salesCount    Int           @default(0)
  ratingAvg     Float         @default(0)
  ratingCount   Int           @default(0)
  sections      ProductSection[]
  attributes    ProductAttributeValue[]
  files         ProductFile[]
  orderItems    OrderItem[]
  libraryItems  LibraryItem[]
  requests      ProductRequest[]
  agreements    CommissionAgreement[]
  reports       ContentReport[]
  /// Why the last review rejected it (shown to the seller)
  reviewNote    String?
  previews      ProductPreview[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  publishedAt   DateTime?

  @@index([status, createdAt])
}

model ProductSection {
  productId String
  sectionId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([productId, sectionId])
}

/// One row per value; MULTISELECT attributes have several rows.
model ProductAttributeValue {
  id          String              @id @default(cuid())
  productId   String
  attributeId String
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  valueText   String?
  valueNumber Float?
  valueBool   Boolean?

  @@index([attributeId, valueText])
  @@index([attributeId, valueNumber])
  @@index([productId])
}

enum FileKind {
  MAIN
  SAMPLE
  EXTRA
}

model ProductFile {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind       FileKind @default(MAIN)
  version    String   @default("1.0")
  changelog  String?
  filename   String
  size       Int
  mimeType   String?
  /// Key in private storage; never served directly.
  storageKey String
  isCurrent  Boolean  @default(true)
  /// Raw result of the type plugin's analysis (for display / debugging).
  analysis   Json?
  createdAt  DateTime @default(now())
}

/// Preview items produced by plugins (Anki cards, PDF pages, audio clips...).
/// `kind` selects the front-end component that renders `data`.
model ProductPreview {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String
  data      Json
  position  Int     @default(0)
}

model Setting {
  key   String @id
  value Json
}

model AdminLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())
}

/// A shared list of choices (languages, levels, subjects...) used by product
/// fields and by generated sections, so menus and filters come from one place.
model OptionList {
  id         String                @id @default(cuid())
  key        String                @unique
  name       Json
  items      OptionItem[]
  attributes AttributeDefinition[]
  sections   Section[]             @relation("SectionChildrenList")
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model OptionItem {
  id        String     @id @default(cuid())
  listId    String
  list      OptionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Stable value stored on products; also the generated section's slug.
  value     String
  label     Json
  /// Iconify name, e.g. i-circle-flags-iq for a flag
  icon      String?
  /// Optional uploaded image (public storage key), shown instead of the icon
  image     String?
  sortOrder Int        @default(0)
  section   Section?

  @@unique([listId, value])
}

/// One-time login codes sent by SMS or email. Only a hash of the code is stored.
model OtpCode {
  id         String    @id @default(cuid())
  /// Normalised phone (09xxxxxxxxx) or lower-case email
  target     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([target, createdAt])
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_VERIFICATION
  PAID
  REJECTED
  CANCELLED
  REFUNDED
}

model Order {
  id            String      @id @default(cuid())
  /// Short number shown to buyers and support
  number        Int         @unique @default(autoincrement())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status        OrderStatus @default(PENDING_PAYMENT)
  subtotal      Int
  discount      Int         @default(0)
  total         Int
  currency      String
  /// Key of the payment method chosen at checkout (zarinpal, card, iban...)
  paymentMethod String?
  paidAt        DateTime?
  adminNote     String?
  items         OrderItem[]
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
}

/// A product in an order, with its price and the seller/store split frozen at purchase.
model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  sellerId          String?
  title             Json
  unitPrice         Int
  commissionPercent Float    @default(0)
  /// Store's share and seller's share, filled when the order is paid
  commission        Int      @default(0)
  sellerNet         Int      @default(0)
}

enum PaymentStatus {
  STARTED
  SUBMITTED
  PAID
  FAILED
  REJECTED
}

/// One payment attempt: an online gateway transaction or a manual transfer with a receipt.
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        String
  amount        Int
  status        PaymentStatus @default(STARTED)
  /// Gateway fields
  authority     String?       @unique
  refId         String?
  cardPan       String?
  /// Manual transfer fields
  receiptKey    String?
  receiptHash   String?
  payerCard4    String?
  reference     String?
  transferredAt DateTime?
  rejectReason  String?
  reviewedById  String?
  reviewedAt    DateTime?
  raw           Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([reference])
  @@index([receiptHash])
}

/// What a buyer owns: one row per product, granted when an order is paid (or for free products).
model LibraryItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String?
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  downloads Download[]

  @@unique([userId, productId])
}

model Download {
  id            String      @id @default(cuid())
  libraryItemId String
  libraryItem   LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId        String
  ip            String?
  createdAt     DateTime    @default(now())
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  DONE
  DECLINED
}

/// A buyer asks for a product that doesn't exist yet (e.g. a deck from one
/// language to another on a subject). Staff answer in its message thread.
/// All text is stored and shown as plain text, never as HTML.
model ProductRequest {
  id          String           @id @default(cuid())
  number      Int              @unique @default(autoincrement())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Values from the shared list named in settings (languages by default)
  source      String
  target      String
  subject     String
  details     String?
  status      RequestStatus    @default(OPEN)
  /// The product made for this request, once it exists
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Unread flags for the badge counts on both sides
  unreadStaff Boolean          @default(true)
  unreadUser  Boolean          @default(false)
  messages    RequestMessage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, updatedAt])
  @@index([userId, createdAt])
}

model RequestMessage {
  id        String         @id @default(cuid())
  requestId String
  request   ProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromStaff Boolean        @default(false)
  body      String
  createdAt DateTime       @default(now())
}

enum AgreementStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// A commission rate for one seller, negotiated or set by the store.
/// Scope: the whole seller, one section, or one product (most specific wins).
model CommissionAgreement {
  id          String          @id @default(cuid())
  sellerId    String
  seller      Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  percent     Float
  sectionId   String?
  section     Section?        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  startsAt    DateTime        @default(now())
  endsAt      DateTime?
  status      AgreementStatus @default(PROPOSED)
  /// Who made this offer: the seller, or the store (a counter-offer or a direct rate)
  proposedBy  String          // seller | store
  note        String?
  answer      String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime        @default(now())

  @@index([sellerId, status])
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

model Payout {
  id        String       @id @default(cuid())
  sellerId  String
  seller    Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount    Int
  status    PayoutStatus @default(REQUESTED)
  sheba     String
  reference String?
  note      String?
  paidAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([sellerId, status])
}

/// "Report this product": copyright, wrong content, etc.
model ContentReport {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String   // copyright | wrong | offensive | other
  details   String?
  contact   String?
  status    String   @default("open") // open | resolved | dismissed
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
